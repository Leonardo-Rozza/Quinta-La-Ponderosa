# URL pública HTTPS usada en retornos y webhooks de Mercado Pago.
SITE_URL=https://quinta.example.com

# Supabase (service role: únicamente servidor).
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Mercado Pago Checkout Pro.
MP_ACCESS_TOKEN=replace-me
MP_WEBHOOK_SECRET=replace-me
MP_COLLECTOR_ID=123456789
MP_LIVE_MODE=false

# Protege URLs de estado y reintento retornadas al navegador.
RESERVA_STATUS_SECRET=replace-with-at-least-32-random-bytes

# Crons y limitación distribuida de abuso. Los schedules de vercel.json (5/15 min)
# requieren Vercel Pro/Enterprise o un scheduler externo con Authorization Bearer.
CRON_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
RESERVA_MAX_ADVANCE_DAYS=365
# Buckets independientes; Postgres impone además un máximo de 2 holds
# pendientes por IP, incluidas las expiradas que todavía no fueron conciliadas.
RESERVA_RATE_LIMIT_IP=8
RESERVA_RATE_WINDOW_SECONDS_IP=900
RESERVA_RATE_LIMIT_EMAIL=3
RESERVA_RATE_WINDOW_SECONDS_EMAIL=1800

# Ajustes opcionales de red y firma de Mercado Pago.
MP_TIMEOUT_MS=8000
MP_WEBHOOK_TOLERANCE_SECONDS=300
# Gracia post-hold y separación mínima entre dos búsquedas vacías antes de cancelar.
MP_RECONCILIATION_GRACE_MINUTES=30
MP_EMPTY_RECHECK_MINUTES=15
# Intervalo para volver a conciliar pagos pendientes o fallos transitorios (15..1440).
RESERVA_RECONCILIATION_RETRY_MINUTES=15

# Emails transaccionales. En deploy, el checkout se bloquea si la credencial no
# tiene formato de Resend, EMAIL_FROM no es válido o no hay un destinatario válido.
RESEND_API_KEY=replace-me
EMAIL_FROM=La Ponderosa <reservas@example.com>
# Puede omitirse solo si CONFIG.email sigue siendo una dirección válida.
OWNER_EMAIL=reservas@example.com
